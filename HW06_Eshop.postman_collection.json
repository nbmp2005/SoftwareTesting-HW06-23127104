          {
            "name": "FR02-H-005 Forgot-password enumeration comparison",
            "description": "Run with exactly two ordered iteration rows: registered then unknown. Required fields: accountVariant and probeEmail. The script compares status, top-level schema and generic message; resetToken values are intentionally not compared.",
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const probeEmail = pm.iterationData.get('probeEmail');",
                    "const accountVariant = pm.iterationData.get('accountVariant');",
                    "if (!probeEmail) throw new Error('FR02-H-005 requires probeEmail in iteration data');",
                    "if (!['registered', 'unknown'].includes(accountVariant)) throw new Error('FR02-H-005 accountVariant must be registered or unknown');",
                    "pm.request.body.update(JSON.stringify({ email: pm.variables.replaceIn(String(probeEmail)) }));"
                  ]
                }
              },
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const variant = pm.iterationData.get('accountVariant');",
                    "let body;",
                    "let parseError;",
                    "try { body = pm.response.json(); } catch (error) { parseError = error; }",
                    "pm.test('[FR02-H-005] forgot-password response is JSON', function () {",
                    "    pm.expect(parseError, parseError && parseError.message).to.equal(undefined);",
                    "});",
                    "if (!parseError) {",
                    "    const keys = Object.keys(body).sort().join(',');",
                    "    const message = typeof body.message === 'string' ? body.message : '';",
                    "    pm.test('[FR02-H-005] response has no explicit account-existence field', function () {",
                    "        ['exists', 'registered', 'userExists', 'userFound'].forEach((key) => pm.expect(body).to.not.have.property(key));",
                    "    });",
                    "    if (variant === 'registered') {",
                    "        pm.test('[FR02-H-005] registered-email baseline follows documented success contract', function () {",
                    "            pm.response.to.have.status(200);",
                    "            pm.expect(body).to.have.property('resetToken').that.is.a('string').and.not.empty;",
                    "        });",
                    "        pm.collectionVariables.set('fr02H005Status', String(pm.response.code));",
                    "        pm.collectionVariables.set('fr02H005Keys', keys);",
                    "        pm.collectionVariables.set('fr02H005Message', message);",
                    "    } else {",
                    "        const baselineStatus = pm.collectionVariables.get('fr02H005Status');",
                    "        const baselineKeys = pm.collectionVariables.get('fr02H005Keys');",
                    "        const baselineMessage = pm.collectionVariables.get('fr02H005Message');",
                    "        pm.test('[FR02-H-005] unknown-email response matches registered-email status and schema', function () {",
                    "            pm.expect(baselineStatus, 'run registered row before unknown row').to.not.equal(undefined);",
                    "            pm.expect(String(pm.response.code)).to.equal(baselineStatus);",
                    "            pm.expect(keys).to.equal(baselineKeys);",
                    "            pm.expect(message).to.equal(baselineMessage);",
                    "        });",
                    "        pm.collectionVariables.unset('fr02H005Status');",
                    "        pm.collectionVariables.unset('fr02H005Keys');",
                    "        pm.collectionVariables.unset('fr02H005Message');",
                    "    }",
                    "}"
                  ]
                }
              }
            ],
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "type": "text"
                },
                {
                  "key": "X-Student-Id",
                  "value": "{{studentId}}",
                  "type": "text"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\"email\":\"{{probeEmail}}\"}",
                "options": {
                  "raw": {
                    "language": "json"
                  }
                }
              },
              "url": {
                "raw": "{{baseUrl}}/api/forgot-password",
                "host": [
                  "{{baseUrl}}"
                ],
                "path": [
                  "api",
                  "forgot-password"
                ]
              }
            },
            "response": []
          }
        ]

            "name": "FR-10 Persisted State Verification (Data-Driven)",
            "description": "Uses the admin order list as an independent follow-up read and verifies expectedState for verifyOrderId after each mutation/race row.",
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const tcId = String(pm.iterationData.get('tcId') || '').trim();",
                    "const verifyOrderId = pm.variables.replaceIn(String(pm.iterationData.get('verifyOrderId') || ''));",
                    "const expectedState = pm.variables.replaceIn(String(pm.iterationData.get('expectedState') || ''));",
                    "const adminToken = pm.environment.get('fr10AdminToken') || pm.collectionVariables.get('fr10AdminToken') || '';",
                    "pm.variables.set('fr10TcId', tcId);",
                    "pm.variables.set('fr10VerifyOrderId', verifyOrderId);",
                    "pm.variables.set('fr10ExpectedState', expectedState);",
                    "pm.variables.set('fr10AdminFixturePresent', String(Boolean(adminToken)));",
                    "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + adminToken });",
                    "pm.request.headers.upsert({ key: 'X-Student-Id', value: '{{studentId}}' });"
                  ]
                }
              },
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const tcId = pm.variables.get('fr10TcId') || '';",
                    "const verifyOrderId = pm.variables.get('fr10VerifyOrderId') || '';",
                    "const expectedState = pm.variables.get('fr10ExpectedState') || '';",
                    "const label = (text) => '[' + (tcId || 'MISSING-TC-ID') + '] ' + text;",
                    "",
                    "pm.test(label('verification inputs and admin fixture are resolved'), function () {",
                    "    pm.expect(tcId).to.match(/^FR10-(?:AI|H)-\\d{3}$/);",
                    "    pm.expect(pm.variables.get('fr10AdminFixturePresent')).to.equal('true');",
                    "    pm.expect(verifyOrderId).to.not.equal('').and.not.match(/{{.+}}/);",
                    "    pm.expect(expectedState).to.not.equal('').and.not.match(/{{.+}}/);",
                    "});",
                    "pm.test(label('verification read succeeds'), function () {",
                    "    pm.response.to.have.status(200);",
                    "    pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/json/i);",
                    "});",
                    "",
                    "let body;",
                    "let parseError;",
                    "try { body = pm.response.json(); } catch (error) { parseError = error; }",
                    "pm.test(label('verification response is valid JSON'), function () {",
                    "    pm.expect(parseError, parseError && parseError.message).to.equal(undefined);",
                    "});",
                    "pm.test(label('persisted order state matches the post-state oracle'), function () {",
                    "    pm.expect(body, 'verification JSON must parse').to.not.equal(undefined);",
                    "    const orders = Array.isArray(body) ? body : (Array.isArray(body.orders) ? body.orders : body.data);",
                    "    pm.expect(orders, 'admin order list must be an array or expose orders/data array').to.be.an('array');",
                    "    const order = orders.find((item) => String(item.id) === String(verifyOrderId));",
                    "    pm.expect(order, 'verifyOrderId must exist in admin order list').to.be.an('object');",
                    "    const allowedStates = expectedState.split('|').map((state) => state.trim()).filter(Boolean);",
                    "    pm.expect(allowedStates).to.include(String(order.status));",
                    "});"
                  ]
                }
              }
